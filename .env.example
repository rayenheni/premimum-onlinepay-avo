# Keep the existing DATABASE_URL in .env.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Multi-tenant platform: subdomain suffix for each lawyer's site (e.g. cabinet-xyz.plateforme.tn).
PLATFORM_DOMAIN=plateforme.tn

# Fallback tenant used for the main domain and local previews.
DEFAULT_TENANT_SLUG=labbaoui

# Public origin, required for the provider to reach payment callbacks.
SITE_URL=https://your-cabinet-domain.tn

# Konnect credentials stay on the server. Empty credentials disable charging.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_ENV=sandbox

# Only approved firm contact information should be supplied.
CABINET_EMAIL=
CABINET_PHONE=
CABINET_WHATSAPP=

# Optional HTTPS embed from youtube-nocookie.com, youtube.com or player.vimeo.com.
CABINET_INTRO_VIDEO_URL=

# Optional first-load private admin path. It can later be changed inside Settings.
ADMIN_PATH=private-cabinet-console
ADMIN_SETUP_KEY=

# Optional transactional e-mail provider (Resend HTTP API).
RESEND_API_KEY=
EMAIL_FROM=Cabinet Labbaoui <notifications@your-domain.tn>
ADMIN_NOTIFICATION_EMAIL=
