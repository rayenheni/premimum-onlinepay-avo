# PostgreSQL database for ONE law-firm installation.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/law_firm_template

# Canonical public URL. Required when Konnect payments are enabled.
SITE_URL=https://www.your-law-firm.tn

# Required before creating the first administrator in production.
# Generate a long random secret and keep it private.
ADMIN_SETUP_KEY=replace-with-a-long-random-secret

# Konnect credentials remain server-only. Leave empty to disable online checkout.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_ENV=sandbox

# Optional public contact fallbacks. These values can also be managed in Admin → Settings.
CABINET_EMAIL=
CABINET_PHONE=
CABINET_WHATSAPP=

# Optional transactional e-mail delivery through Resend.
RESEND_API_KEY=
EMAIL_FROM=Your Law Firm <notifications@your-domain.tn>
ADMIN_NOTIFICATION_EMAIL=

# Optional licensed intro video. Leave unset to hide the video preview.
CABINET_INTRO_VIDEO_URL=
